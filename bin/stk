#!/usr/bin/env bash
# stk — shopify toolkit dispatcher.
# Runs tools under $ROOT/tools/<name>/. No args → fzf picker.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
TOOLS="$ROOT/tools"

list_tools() {
  for d in "$TOOLS"/*/; do [ -d "$d" ] && basename "$d"; done
}

desc() {
  local f="$TOOLS/$1/.desc"
  [ -f "$f" ] && cat "$f" || echo "(no description)"
}

run_tool() {
  local name="$1"; shift
  if [ -f "$TOOLS/$name/$name.js" ]; then
    exec node "$TOOLS/$name/$name.js" "$@"
  elif [ -x "$TOOLS/$name/run" ]; then
    exec "$TOOLS/$name/run" "$@"
  else
    echo "stk: unknown tool '$name'" >&2
    echo "available: $(list_tools | paste -sd', ' -)" >&2
    exit 1
  fi
}

case "${1:-}" in
  ls|list|-h|--help|help)
    echo "stk — shopify toolkit"
    echo "Usage: stk [tool] [args...]    (no tool → fzf picker)"
    echo
    echo "Tools:"
    for t in $(list_tools); do printf '  %-14s %s\n' "$t" "$(desc "$t")"; done
    ;;
  "")
    command -v fzf >/dev/null || { echo "stk: fzf not installed. Run: brew install fzf" >&2; exit 1; }
    sel="$(list_tools | fzf --prompt='stk > ' --height=40% --reverse \
      --preview "cat '$TOOLS'/{}/.desc 2>/dev/null" --preview-window=down,3,wrap)" || exit 0
    [ -n "$sel" ] && run_tool "$sel"
    ;;
  *)
    run_tool "$@"
    ;;
esac
